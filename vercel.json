{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd app-juegos && npm install",
  "buildCommand": "cd app-juegos && npm run build",
  "outputDirectory": "app-juegos/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
